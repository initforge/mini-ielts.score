# =============================================================================
# Anish TOEIC — Environment Variables (development / CI)
# =============================================================================
# Copy to .env and populate for local or CI runs.
# Production secrets belong in env.production.example (PM2 env: block).

# ── Cloudflare AI Worker (grading adapter) ──────────────────────────────────
CLOUDFLARE_AI_WORKER_URL=
CLOUDFLARE_AI_WORKER_TOKEN=
CLOUDFLARE_AI_TIMEOUT_MS=60000

# ── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anish_toeic

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-at-least-32-characters-long!!
JWT_EXPIRES_IN=7d

# ── S3 / Media ──────────────────────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
