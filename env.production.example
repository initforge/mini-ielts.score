# =============================================================================
# Anish TOEIC — Production Environment Variables
# =============================================================================
# Copy this file to .env on the VPS and populate real values.
# These must match the PM2 env: block in ecosystem.config.cjs.
#
# R3-SECURITY: the JWT_SECRET placeholder below is REJECTED by the zod schema
# (config/env.ts rejects any value containing 'REPLACE_WITH'). Both the web
# service AND the grading worker refuse to boot until you set a real secret
# (>=32 chars), e.g.:  openssl rand -base64 48
# CORS_ORIGIN must NOT be '*' — the server always sends credentials:true.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=7000

# ── Cloudflare AI Worker (grading adapter) ──────────────────────────────────
CLOUDFLARE_AI_WORKER_URL=
CLOUDFLARE_AI_WORKER_TOKEN=
CLOUDFLARE_AI_TIMEOUT_MS=60000

# ── Grading test mode — deterministic scores. NEVER true in production. ─────
AI_GRADING_TEST_MODE=false

# ── Redis ───────────────────────────────────────────────────────────────────
# Session revocation store (jti keys) + grading worker queue + job locks.
REDIS_URL=redis://127.0.0.1:6379

# ── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── JWT ─────────────────────────────────────────────────────────────────────
# R3-SECURITY: sessions are now revocable — login stores jti:<jti> -> userId
# in Redis (TTL = JWT_EXPIRES_IN), logout deletes it, and requireAuth rejects
# any token whose jti key is missing. JWT_SECRET must be a real >=32-char
# secret; the placeholder is rejected at boot (fail closed).
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_32+chars
JWT_EXPIRES_IN=7d

# ── S3 / Media — OPTIONAL ───────────────────────────────────────────────────
# MinIO on the VPS sets S3_ENDPOINT (e.g. http://127.0.0.1:9000); production
# AWS S3 also uses these names (media.adapter falls back to AWS_REGION /
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION if S3_* are empty).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Explicit origin list (comma-separated). '*' is FORBIDDEN: server.ts always
# sets credentials:true, and browsers reject '*' combined with credentials.
CORS_ORIGIN=https://webinprogress.click

# ── Trust proxy — MUST be true in prod (behind nginx) so rate-limit identity
# ── resolves to the real client IP instead of 127.0.0.1. ───────────────────
TRUST_PROXY=true
