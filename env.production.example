# =============================================================================
# Anish TOEIC — Production Environment Variables
# =============================================================================
# Copy this file to .env on the VPS and populate real values.
# These must match the PM2 env: block in ecosystem.config.cjs.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=7000

# ── Cloudflare AI Worker (grading adapter) ──────────────────────────────────
CLOUDFLARE_AI_WORKER_URL=
CLOUDFLARE_AI_WORKER_TOKEN=
CLOUDFLARE_AI_TIMEOUT_MS=60000

# ── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── S3 / Media ──────────────────────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://webinprogress.click
