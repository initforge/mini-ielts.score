{
  "name": "anish-toeic-web-services",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path');for(const f of fs.readdirSync('src/migrations'))if(f.endsWith('.sql'))fs.copyFileSync(p.join('src/migrations',f),p.join('dist/migrations',f));\"",
    "start": "node dist/server.js",
    "lint": "eslint . --ext ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "seed": "npm run build && node dist/migrations/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "cookie-parser": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.9.0",
    "yauzl": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
