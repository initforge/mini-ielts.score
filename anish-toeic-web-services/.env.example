# Copy to .env for local development. All values are dev-only — never reuse
# the DB password or JWT secret below outside a local disposable environment.
NODE_ENV=development
PORT=7000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anish_toeic

JWT_SECRET=change-me-at-least-32-characters-long!!
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

REDIS_URL=redis://127.0.0.1:6379

# ── Cloudflare AI Worker (grading adapter) — optional; absent => AI_PROVIDER_NOT_CONFIGURED ──
CLOUDFLARE_AI_WORKER_URL=
CLOUDFLARE_AI_WORKER_TOKEN=
CLOUDFLARE_AI_TIMEOUT_MS=60000

# ── Grading test mode — deterministic double scores, no network AI. Dev/test ONLY. ──
AI_GRADING_TEST_MODE=false

# ── S3 / Media (presigned uploads) — optional; absent => presign endpoint 503 in prod ──
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── Trust proxy — true ONLY behind nginx/Cloudflare. false in direct/dev. ──
TRUST_PROXY=false
